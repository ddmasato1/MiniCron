# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv

# Runtime data and exports
/data/*
!/data/logs/
/data/logs/*
!/data/logs/.gitkeep
*.log
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite*

